<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
    Allure's TestNG listener is registered automatically through ServiceLoader
    (allure-testng on the classpath), so no <listeners> block is required.
    Classes run sequentially to stay well within GoRest's public rate limits.
-->
<suite name="GoRest API Regression Suite" verbose="1">

    <test name="User CRUD - Request Chaining">
        <classes>
            <class name="com.sdet.framework.tests.UserChainingTests"/>
        </classes>
    </test>

    <test name="User - Data Driven">
        <classes>
            <class name="com.sdet.framework.tests.UserDataDrivenTests"/>
        </classes>
    </test>

</suite>
